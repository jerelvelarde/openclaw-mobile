# Expo + Metro
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native projects: P04A switches us to a custom dev client
# (`react-native-zeroconf` is not in Expo Go). `expo prebuild` generates
# `ios/` and `android/` from `app.config.ts`; we commit them so EAS / CI
# can build without re-running prebuild every time. Only the per-machine
# build outputs are ignored.
/ios/build/
/ios/Pods/
/ios/*.xcworkspace/xcuserdata/
/ios/*.xcodeproj/xcuserdata/
/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
/ios/Podfile.lock.local
/android/.gradle/
/android/.idea/
/android/build/
/android/app/build/
/android/local.properties

# Tests / coverage
coverage/
